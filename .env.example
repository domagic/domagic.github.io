# 复制为 .env / .env.development.local / .env.production.local 后按需修改；默认 mock，无需后端即可运行
# mock | http | static（static：构建期消费 P2-B1 导出 JSON，只读公开内容，零运行时请求）
VITE_API_MODE=mock
# http 模式下的后端地址（生产仅 HTTPS；不得写入任何密钥）
VITE_API_BASE_URL=https://api.example.com
# CSP connect-src 追加来源（空格分隔），需与 API 地址一致；开发环境另需 Vite HMR 的 ws 来源
VITE_CSP_CONNECT_SRC=https://api.example.com
# 部署 base：用户站 domagic.github.io 用 /；项目站用 /仓库名/
VITE_BASE=/