# 开发环境默认 mock；http 联调时改为 VITE_API_MODE=http（或建 .env.development.local 覆盖）
VITE_API_MODE=mock
VITE_API_BASE_URL=http://localhost:3000
# CSP connect-src 追加来源（空格分隔）：本地后端 + Prism mock + Vite HMR websocket
VITE_CSP_CONNECT_SRC=http://localhost:3000 http://127.0.0.1:4010 ws://127.0.0.1:5173 ws://localhost:5173