{
  "name": "domagic-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "domagic.github.io personal site frontend (Vue 3 + Vite, mock/http API switchable)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "katex": "^0.19.1",
    "marked": "^16.0.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.0.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.0.1"
  }
}
